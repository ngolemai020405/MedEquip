@using Newtonsoft.Json.Linq
@model List<JObject>
@{ ViewData["Title"] = "Đơn hàng"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-primary"><i class="bi bi-receipt me-2"></i>Quản lý Đơn hàng</h3>
</div>
@if (ViewBag.LoiRaw != null)
{
    <div class="alert alert-danger">
        <strong>Lỗi API:</strong>
        <pre class="mt-2 text-wrap">@ViewBag.LoiRaw</pre>
    </div>
}
<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead><tr><th>Ma DH</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o["orderId"]</td>
                <td>@o["user"]!["hoTen"]</td>
                <td>@o["ngayDat"]</td>
                <td>@o["tongTien"] VND</td>
                <td><span class="badge bg-info text-dark">@o["trangThai"]</span></td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Detail" asp-route-id="@o["orderId"]">Chi tiết</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>