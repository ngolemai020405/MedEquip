@using Newtonsoft.Json.Linq
@model JObject
@{ ViewData["Title"] = "Chi tiết Đơn hàng"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">Chi tiết Đơn hàng #@Model["orderId"]</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Quay lại</a>
</div>
@if(TempData["Thanhcong"] != null)
{
    <div class="alert alert-success">@TempData["Thanhcong"]</div>
}
<div class="row">
    <div class="col-md-6">
        <div class="card p-4 mb-4 shadow-sm">
            <h5 class="fw-bold mb-3"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Thông tin Giao hàng</h5>
            <p class="mb-2"><b>Khách hàng:</b> @Model["user"]?["hoTen"]</p>
            <p class="mb-2"><b>Địa chỉ:</b> @Model["diaChiGiaoDayDu"]</p>
            <p class="mb-2"><b>SĐT nhận:</b> @Model["sdtNhan"]</p>
            <p class="mb-2"><b>Xác nhận chính chủ:</b> @((bool)(Model["xacNhanChinhChu"] ?? false) ? "Đã xác nhận" : "Chưa xác nhận")</p>
            <p class="mb-2"><b>Phương thức TT:</b> @Model["phuongThucThanhToan"] 
                @if((bool)Model["daThanhToan"]!) { <span class="badge bg-success ms-1">Đã thanh toán</span> }
                else { <span class="badge bg-warning text-dark ms-1">Chưa thanh toán</span> }
            </p>
            <p class="mb-2"><b>Ghi chú:</b> @Model["ghiChu"]</p>
            <p class="mb-0"><b>Ngày đặt:</b> @Convert.ToDateTime(Model["ngayDat"]).ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4 mb-4 shadow-sm">
            <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-warning"></i>Cập nhật Trạng thái</h5>
            <form asp-action="CapNhatTrangThai" asp-route-id="@Model["orderId"]" method="post">
                <div class="d-flex gap-2 align-items-center mb-3">
                    <select name="trangThai" class="form-select border-primary">
                        <option value="ChoXacNhan" selected="@((string)Model["trangThai"]! == "ChoXacNhan")">Chờ xác nhận</option>
                        <option value="DaXacNhan" selected="@((string)Model["trangThai"]! == "DaXacNhan")">Đã xác nhận</option>
                        <option value="DangGiao" selected="@((string)Model["trangThai"]! == "DangGiao")">Đang giao</option>
                        <option value="DaGiao" selected="@((string)Model["trangThai"]! == "DaGiao")">Đã giao</option>
                        <option value="DaHuy" selected="@((string)Model["trangThai"]! == "DaHuy")">Đã hủy</option>
                    </select>
                    <button class="btn btn-primary text-nowrap px-4"><i class="bi bi-check-lg me-1"></i> Cập nhật</button>
                </div>
            </form>
            <p class="mb-0">Trạng thái hiện tại: 
                @{
                    string tt = (string)Model["trangThai"]!;
                    string badge = tt == "DaGiao" ? "bg-success" : (tt == "DaHuy" ? "bg-danger" : "bg-info text-dark");
                    string txt = tt == "ChoXacNhan" ? "Chờ xác nhận" : (tt == "DaXacNhan" ? "Đã xác nhận" : (tt == "DangGiao" ? "Đang giao" : (tt == "DaGiao" ? "Đã giao" : "Đã hủy")));
                }
                <span class="badge @badge fs-6">@txt</span>
            </p>
        </div>
    </div>
</div>
<div class="card shadow-sm p-0 mb-5">
    <div class="card-header bg-white p-4 pb-0 border-0">
        <h5 class="fw-bold mb-0"><i class="bi bi-box-seam me-2 text-info"></i>Chi tiết Sản phẩm</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn Giá</th>
                        <th>Số lượng</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model["orderDetails"]!)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@d["product"]!["hinhAnh"]" style="width:40px;height:40px;object-fit:cover;" class="rounded me-2" />
                                <span>@d["product"]!["tenSP"]</span>
                            </div>
                        </td>
                        <td>@Convert.ToDecimal(d["donGia"]).ToString("N0") VNĐ</td>
                        <td>@d["soLuong"]</td>
                        <td class="text-end fw-semibold text-primary">@((Convert.ToDecimal(d["donGia"]) * Convert.ToInt32(d["soLuong"])).ToString("N0")) VNĐ</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-light text-end p-4">
        <h5 class="mb-0">Tổng tiền: <span class="text-danger fw-bold ms-2">@Convert.ToDecimal(Model["tongTien"]).ToString("N0") VNĐ</span></h5>
    </div>
</div>