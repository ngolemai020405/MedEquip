@model WebAdmin.Models.PromotionsVM
@{ ViewData["Title"] = "Cập nhật Khuyến mãi"; }
<div class="row justify-content-center">
    <div class="col-lg-6">
        <h3 class="fw-bold mb-4">Cập nhật Khuyến mãi</h3>
        @if (ViewBag.Loi != null) { <div class="alert alert-danger">@ViewBag.Loi</div> }
        <div class="card p-4 shadow-sm">
            <form asp-action="Edit" asp-route-id="@Model.PromotionId" method="post">
                <input type="hidden" asp-for="PromotionId" />
                <div class="mb-3">
                    <label class="form-label">Tên khuyến mãi</label>
                    <input asp-for="TenKM" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea asp-for="MoTa" class="form-control"></textarea>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Phần trăm giảm (%)</label>
                        <input type="number" asp-for="PhanTramGiam" class="form-control" required min="1" max="100" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ngày bắt đầu</label>
                        <input type="date" asp-for="NgayBatDau" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ngày kết thúc</label>
                        <input type="date" asp-for="NgayKetThuc" class="form-control" required />
                    </div>
                </div>
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="TrangThai">
                    <label class="form-check-label">Kích hoạt (Đang chạy)</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>