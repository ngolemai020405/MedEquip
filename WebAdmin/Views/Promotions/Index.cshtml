@using Newtonsoft.Json.Linq
@model List<JObject>
@{ ViewData["Title"] = "Khuyến mãi"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-primary"><i class="bi bi-percent me-2"></i>Quản lý Khuyến mãi</h3>
    <a class="btn btn-primary rounded-pill px-4 shadow-sm" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> Thêm khuyến mãi
    </a>
</div>
@if(TempData["Thanhcong"] != null)
{
    <div class="alert alert-success">@TempData["Thanhcong"]</div>
}
<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tên KM</th>
                <th>% Giảm</th>
                <th>Bắt đầu</th>
                <th>Kết thúc</th>
                <th>SP áp dụng</th>
                <th>Trạng thái</th>
                <th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td class="fw-bold">@p["tenKM"]</td>
                <td>@p["phanTramGiam"]%</td>
                <td>@Convert.ToDateTime(p["ngayBatDau"]).ToString("dd/MM/yyyy")</td>
                <td>@Convert.ToDateTime(p["ngayKetThuc"]).ToString("dd/MM/yyyy")</td>
                <td>@(((JArray)p["productPromotions"]!).Count) Sản phẩm</td>
                <td>
                    @if ((bool)p["trangThai"]!) { <span class="badge bg-success">Đang chạy</span> }
                    else { <span class="badge bg-secondary">Tạm dừng</span> }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@p["promotionId"]" class="btn btn-warning btn-sm me-1"><i class="bi bi-pencil"></i> Sửa</a>
                    <form asp-action="Delete" asp-route-id="@p["promotionId"]" method="post" class="d-inline" onsubmit="return confirm('Xác nhận xóa khuyến mãi này?');">
                        <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>