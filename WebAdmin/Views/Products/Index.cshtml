@using Newtonsoft.Json.Linq
@model JObject
@{ ViewData["Title"] = "Sản phẩm"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-primary"><i class="bi bi-box-seam me-2"></i>Quản lý Sản phẩm</h3>
    <a class="btn btn-primary rounded-pill px-4 shadow-sm" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
    </a>
</div>
<div class="card border-0 shadow-sm rounded-4 mb-4 p-3">
    <form method="get" class="d-flex gap-3 align-items-center">
        <div class="flex-grow-1" style="max-width:400px">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên sản phẩm..." />
            </div>
        </div>
        <button class="btn btn-outline-primary rounded-pill px-4">Tìm kiếm</button>
    </form>
</div>
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="ps-4">Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Nhà cung cấp</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Đánh giá</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null)
                {
                    foreach (var p in Model["items"]!)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark text-truncate" style="max-width: 200px;" title="@p["tenSP"]">@p["tenSP"]</td>
                            <td class="text-muted">@p["tenDanhMuc"]</td>
                            <td class="text-muted">@p["tenNCC"]</td>
                            <td class="fw-bold text-primary">@(Convert.ToDecimal(p["gia"]).ToString("N0")) đ</td>
                            <td>
                                @if ((int)p["soLuongTon"]! < 10) { <span class="badge bg-danger rounded-pill px-2">@p["soLuongTon"]</span> }
                                else { <span class="badge bg-success rounded-pill px-2">@p["soLuongTon"]</span> }
                            </td>
                            <td><span class="text-warning"><i class="bi bi-star-fill me-1"></i></span>@(((double)p["diemDanhGiaTB"]!).ToString("0.0"))</td>
                            <td>
                                @if ((bool)p["trangThai"]!) { <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Đang bán</span> }
                                else { <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Ngừng bán</span> }
                            </td>
                            <td class="text-end pe-4">
                                <a class="btn btn-sm btn-light text-info rounded-circle me-1" asp-action="ThongKe" asp-route-id="@p["productId"]" title="Thống kê"><i class="bi bi-bar-chart-fill"></i></a>
                                <a class="btn btn-sm btn-light text-primary rounded-circle me-1" asp-action="Edit" asp-route-id="@p["productId"]" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                <form asp-action="Delete" asp-route-id="@p["productId"]" method="post" class="d-inline" onsubmit="return confirm('Ngừng kinh doanh sản phẩm này?')">
                                    <button class="btn btn-sm btn-light text-danger rounded-circle" title="Ngừng bán"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model != null)
    {
        var currentPage = (int)Model["page"]!;
        var pageSize = (int)Model["pageSize"]!;
        var total = (int)Model["total"]!;
        var totalPages = (int)Math.Ceiling((double)total / pageSize);

        <div class="card-footer bg-white border-0 pt-3 pb-3 px-4 d-flex justify-content-between align-items-center">
            <div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Tổng số sản phẩm: <strong>@total</strong></div>
            
            @if (totalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?keyword=@ViewBag.Keyword&page=@(currentPage - 1)">Trước</a>
                        </li>
                        <li class="page-item disabled"><span class="page-link">@currentPage / @totalPages</span></li>
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="?keyword=@ViewBag.Keyword&page=@(currentPage + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>