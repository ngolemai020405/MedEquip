@model Newtonsoft.Json.Linq.JObject
@{
    ViewData["Title"] = "Thống kê sản phẩm: " + Model["tenSP"];
    var product = ViewBag.Product as Newtonsoft.Json.Linq.JObject;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Thống kê sản phẩm</h1>
    <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
</div>

<div class="row">
    <!-- Hình ảnh & Thông tin cơ bản -->
    <div class="col-md-4 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Thông tin sản phẩm</h6>
            </div>
            <div class="card-body text-center">
                @if (product != null && product["hinhAnh"] != null)
                {
                    <img src="@product["hinhAnh"]" class="img-fluid rounded mb-3" style="max-height: 200px;" alt="@Model["tenSP"]" />
                }
                <h5>@Model["tenSP"]</h5>
                <p class="text-muted mb-1">ID: @Model["productId"]</p>
                @if (product != null)
                {
                    <p class="text-danger fw-bold fs-5">@string.Format("{0:N0} đ", product["gia"])</p>
                    <span class="badge @((bool?)product["trangThai"] == true ? "bg-success" : "bg-danger")">
                        @((bool?)product["trangThai"] == true ? "Đang kinh doanh" : "Ngừng kinh doanh")
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Số liệu thống kê -->
    <div class="col-md-8 mb-4">
        <div class="row">
            <!-- Đã bán -->
            <div class="col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Đã bán</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@Model["tongSoLuongDaBan"] <span class="fs-6 fw-normal text-muted">sản phẩm</span></div>
                                <div class="mt-2 text-muted small">Từ @Model["soDonHang"] đơn hàng</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-cart-check fs-1 text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doanh thu -->
            <div class="col-md-6 mb-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    Doanh thu mang lại</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@string.Format("{0:N0} đ", Model["tongDoanhThu"])</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-currency-dollar fs-1 text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tồn kho -->
            <div class="col-md-6 mb-4">
                <div class="card border-left-warning shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                    Tồn kho hiện tại</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">@Model["soLuongTonKho"] <span class="fs-6 fw-normal text-muted">sản phẩm</span></div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-box-seam fs-1 text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Đánh giá -->
            <div class="col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    Điểm đánh giá trung bình</div>
                                <div class="row no-gutters align-items-center">
                                    <div class="col-auto">
                                        <div class="h5 mb-0 mr-3 font-weight-bold text-gray-800">@Model["diemDanhGiaTB"] <i class="bi bi-star-fill text-warning fs-6"></i></div>
                                    </div>
                                </div>
                                <div class="mt-2 text-muted small">Từ @Model["soLuongDanhGia"] lượt đánh giá</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-star fs-1 text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
