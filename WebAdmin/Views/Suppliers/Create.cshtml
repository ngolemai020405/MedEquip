@model SupplierVM
@{ ViewData["Title"] = "Them NCC"; }
<h3>Them nha cung cap</h3>
@if (ViewBag.Loi != null) { <div class="alert alert-danger">@ViewBag.Loi</div> }
<div class="card p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        <div class="mb-3"><label class="form-label">Tên nhà cung cấp</label><input asp-for="TenNCC" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Địa chỉ</label><input asp-for="DiaChi" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">So dien thoai</label><input asp-for="SDT" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Nguoi lien he</label><input asp-for="NguoiLienHe" class="form-control" /></div>
        <button class="btn btn-primary">Lưu</button>
        <a class="btn btn-secondary" asp-action="Index">Huy</a>
    </form>
</div>