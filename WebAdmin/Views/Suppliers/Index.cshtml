@using Newtonsoft.Json.Linq
@model List<JObject>
@{ ViewData["Title"] = "Nha cung cap"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-primary"><i class="bi bi-building me-2"></i>Quản lý Nhà cung cấp</h3>
    <a class="btn btn-primary rounded-pill px-4 shadow-sm" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> Thêm Nhà cung cấp
    </a>
</div>
<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead><tr><th>Tên NCC</th><th>Địa chỉ</th><th>SDT</th><th>Email</th><th>Người liên hệ</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td class="fw-bold">@s["tenNCC"]</td>
                <td>@s["diaChi"]</td>
                <td>@s["sdt"]</td>
                <td>@s["email"]</td>
                <td>@s["nguoiLienHe"]</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s["supplierId"]">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@s["supplierId"]" method="post" style="display:inline" onsubmit="return confirm('Xóa NCC nay?')">
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>