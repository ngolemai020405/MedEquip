@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Quên mật khẩu - MedEquip Admin</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body style="background:#0d6efd; min-height:100vh; display:flex; align-items:center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card shadow p-4">
                    <h4 class="text-center mb-3">🏥 Quên mật khẩu</h4>
                    <p class="text-center text-muted small">Vui lòng nhập email của bạn, chúng tôi sẽ cấp lại mật khẩu.</p>
                    @if (ViewBag.Loi != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Loi</div>
                    }
                    @if (ViewBag.ThanhCong != null)
                    {
                        <div class="alert alert-success">@ViewBag.ThanhCong</div>
                        <a asp-action="Login" class="btn btn-outline-primary w-100 mt-3">Quay lại đăng nhập</a>
                    }
                    else
                    {
                        <form asp-action="ForgotPassword" method="post">
                            <div class="mb-3">
                                <label class="form-label">Email đăng ký</label>
                                <input name="email" type="email" class="form-control" placeholder="Nhập email..." required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Gửi yêu cầu</button>
                            <div class="text-center mt-3">
                                <a asp-action="Login" class="small text-decoration-none text-muted">Quay lại đăng nhập</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>