<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MedEquipMobile.Models"
             xmlns:fonts="clr-namespace:MedEquipMobile.Resources.Fonts"
             x:Class="MedEquipMobile.Views.CartPage"
             Title="Giỏ hàng của bạn"
             BackgroundColor="{StaticResource Background}">
             
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{FontImage FontFamily=MaterialDesignIcons, Glyph={x:Static fonts:IconFont.Account}, Color=White, Size=24}" Command="{Binding LoadCartCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">
        <!-- Danh sách sản phẩm -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding CartItems}" Margin="15,15,15,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartItem">
                    <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="White" Margin="0,0,0,15" Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.05"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="80, *, Auto">
                            <Image Grid.Column="0" Source="dotnet_bot.png" WidthRequest="70" HeightRequest="70" Aspect="AspectFit"/>
                            
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5" Margin="10,0,0,0">
                                <Label Text="{Binding Product.Name}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Product.FinalPrice, StringFormat='{0:N0} đ'}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                <Label Text="{Binding Quantity, StringFormat='Số lượng: {0}'}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                            </VerticalStackLayout>
                            
                            <Button Grid.Column="2" 
                                    Text="{x:Static fonts:IconFont.Delete}" 
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="24"
                                    BackgroundColor="Transparent" 
                                    TextColor="{StaticResource Error}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveItemCommand}"
                                    CommandParameter="{Binding .}" 
                                    VerticalOptions="Center"
                                    WidthRequest="50" HeightRequest="50"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="{x:Static fonts:IconFont.Cart}" FontFamily="MaterialDesignIcons" FontSize="60" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <Label Text="Giỏ hàng trống" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        
        <!-- Phần Thanh Toán (Checkout) -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 25,25,0,0" Stroke="Transparent" BackgroundColor="White" Padding="20,20,20,30">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-5" Radius="15" Opacity="0.1"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="15">
                <Label Text="Thông tin giao hàng" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}"/>
                
                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Secondary}" StrokeThickness="1" BackgroundColor="{StaticResource Background}">
                    <Grid ColumnDefinitions="40, *">
                        <Label Grid.Column="0" Text="{x:Static fonts:IconFont.Phone}" FontFamily="MaterialDesignIcons" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Số điện thoại" Text="{Binding Phone}" Keyboard="Telephone" BackgroundColor="Transparent" />
                    </Grid>
                </Border>
                
                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Secondary}" StrokeThickness="1" BackgroundColor="{StaticResource Background}">
                    <Grid ColumnDefinitions="40, *">
                        <Label Grid.Column="0" Text="{x:Static fonts:IconFont.MapMarker}" FontFamily="MaterialDesignIcons" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Địa chỉ nhận hàng" Text="{Binding Address}" BackgroundColor="Transparent" />
                    </Grid>
                </Border>
                
                <BoxView HeightRequest="1" Color="{StaticResource Secondary}" Margin="0,5" />
                
                <Grid ColumnDefinitions="*,*">
                    <Label Grid.Column="0" Text="Tổng cộng:" TextColor="{StaticResource TextSecondary}" FontSize="16" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{0:N0} VNĐ'}" TextColor="{StaticResource Error}" FontAttributes="Bold" FontSize="22" HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>
                
                <Button Text="ĐẶT HÀNG NGAY" 
                        Command="{Binding CheckoutCommand}" 
                        BackgroundColor="{StaticResource Primary}" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="16"
                        CornerRadius="12" 
                        HeightRequest="55"
                        Margin="0,10,0,0">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,5" Radius="10" Opacity="0.4"/>
                    </Button.Shadow>
                </Button>
                
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
