<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedEquipMobile.Views.RegisterPage"
             Title="Đăng ký">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Entry Placeholder="Họ tên" Text="{Binding Name}" />
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
        <Entry Placeholder="Mật khẩu" Text="{Binding Password}" IsPassword="True" />
        <Button Text="Đăng ký" Command="{Binding RegisterCommand}" Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>
