<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MedEquipMobile.Views.ProfilePage"
             Title="{Binding Title}">
    <VerticalStackLayout Padding="30" Spacing="20">
        <Image Source="dotnet_bot.svg" HeightRequest="100" HorizontalOptions="Center" />
        <Label Text="Thông tin tài khoản" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold" />
        
        <Button Text="Đổi mật khẩu" Command="{Binding ChangePasswordCommand}" />
        <Button Text="Đăng xuất" Command="{Binding LogoutCommand}" BackgroundColor="Red" />
    </VerticalStackLayout>
</ContentPage>
