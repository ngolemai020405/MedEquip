<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Premium Medical Theme Colors -->
    <Color x:Key="Primary">#0E5E6F</Color>
    <Color x:Key="PrimaryDark">#093e49</Color>
    <Color x:Key="Accent">#3A8891</Color>
    <Color x:Key="LightAccent">#E3F4F4</Color>
    <Color x:Key="Secondary">#F2DEBA</Color>
    
    <Color x:Key="Background">#F8F9FA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    
    <Color x:Key="TextPrimary">#2A2A2A</Color>
    <Color x:Key="TextSecondary">#7A7A7A</Color>
    
    <Color x:Key="Success">#28a745</Color>
    <Color x:Key="Warning">#ffc107</Color>
    <Color x:Key="Error">#dc3545</Color>

    <!-- Brush Definitions -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>

    <!-- Basic Colors for Default Styles -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="LightGray">#E5E5E1</Color>
    <Color x:Key="DarkGray">#505050</Color>
</ResourceDictionary>