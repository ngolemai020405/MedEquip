@model LoginVM
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow-sm p-4 border-0 rounded-4 mt-5">
            <h4 class="text-center mb-4 fw-bold">Đăng nhập</h4>
            @if (ViewBag.Loi != null) { <div class="alert alert-danger rounded-3">@ViewBag.Loi</div> }
            <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control rounded-3" placeholder="khachhang1@gmail.com" />
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label fw-semibold mb-0">Mật khẩu</label>
                        <a asp-action="ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                    </div>
                    <input asp-for="MatKhau" type="password" class="form-control rounded-3 mt-1" placeholder="123456" />
                </div>
                <button class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">Đăng nhập</button>
            </form>
            <div class="text-center mt-4">
                <p class="text-muted small mb-2">Tài khoản demo: khachhang1@gmail.com / 123456</p>
                <p class="mb-0">Chưa có tài khoản? <a asp-action="Register" class="text-decoration-none fw-semibold">Đăng ký ngay</a></p>
            </div>
        </div>
    </div>
</div>