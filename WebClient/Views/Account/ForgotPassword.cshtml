@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow-sm p-4 border-0 rounded-4 mt-5">
            <h4 class="text-center mb-3 fw-bold">🏥 Quên mật khẩu</h4>
            <p class="text-center text-muted small mb-4">Vui lòng nhập email của bạn, chúng tôi sẽ cấp lại mật khẩu.</p>
            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger rounded-3">@ViewBag.Loi</div>
            }
            @if (ViewBag.ThanhCong != null)
            {
                <div class="alert alert-success rounded-3">@ViewBag.ThanhCong</div>
                <a asp-action="Login" class="btn btn-outline-primary w-100 mt-3 rounded-pill fw-semibold">Quay lại đăng nhập</a>
            }
            else
            {
                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Email đăng ký</label>
                        <input name="email" type="email" class="form-control rounded-3" placeholder="Nhập email..." required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">Gửi yêu cầu</button>
                    <div class="text-center mt-4">
                        <a asp-action="Login" class="small text-decoration-none text-muted fw-semibold">Quay lại đăng nhập</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>