@model JObject
@{ ViewData["Title"] = "Trang chủ"; }
@{
    var events = ViewBag.Events as List<Newtonsoft.Json.Linq.JObject>;
}

<style>
    .custom-carousel-btn {
        width: 40px; height: 40px;
        background-color: white; border-radius: 50%;
        opacity: 0.9; top: 50%; transform: translateY(-50%);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        display: flex; align-items: center; justify-content: center;
        transition: all 0.3s ease; border: none; z-index: 10;
    }
    .custom-carousel-btn:hover {
        opacity: 1; transform: translateY(-50%) scale(1.1); background-color: white;
    }
    .custom-carousel-btn i { font-size: 1.5rem; }
    .carousel-control-prev.custom-carousel-btn { left: 15px; }
    .carousel-control-next.custom-carousel-btn { right: 15px; }
    .category-sidebar .list-group-item {
        font-size: 0.95rem; border-color: #f1f5f9; transition: all 0.2s;
    }
    .category-sidebar .list-group-item:hover { background-color: var(--primary-color) !important; padding-left: 1.25rem; }
    .category-sidebar .list-group-item:hover, .category-sidebar .list-group-item:hover * { color: white !important; }
    .hover-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>

<div class="row g-3 mb-5 mt-2">
    <!-- Left Sidebar: Categories -->
    <div class="col-lg-3 d-none d-lg-block">
        <div class="card category-sidebar border-primary shadow-sm h-100 rounded-3 overflow-hidden" style="border-top-width: 4px;">
            <div class="card-header bg-white text-primary fw-bold py-3 text-uppercase border-bottom-0">
                <i class="bi bi-list-ul me-2"></i> Danh mục sản phẩm
            </div>
            <div class="list-group list-group-flush" style="max-height: 380px; overflow-y: auto;">
                @foreach (var c in (List<JObject>)ViewBag.DanhMuc)
                {
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c["categoryId"]" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 text-dark">
                        <span class="fw-medium">@c["tenDanhMuc"]</span>
                        <i class="bi bi-chevron-right small text-black-50"></i>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Center: Main Carousel -->
    <div class="col-lg-6 col-md-8">
        @if (events != null && events.Count > 0)
        {
            <div id="eventCarousel" class="carousel slide h-100 rounded-3 overflow-hidden shadow-sm" data-bs-ride="carousel" data-bs-interval="4000">
                <div class="carousel-indicators">
                    @for (int i = 0; i < events.Count; i++)
                    {
                        <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner h-100">
                    @for (int i = 0; i < events.Count; i++)
                    {
                        var evt = events[i];
                        <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                            @{
                                string hinhAnh = evt["hinhAnh"]?.ToString() ?? "";
                                if (hinhAnh.StartsWith("/images/")) hinhAnh = "https://localhost:7001" + hinhAnh;
                            }
                            @if (!string.IsNullOrEmpty(evt["duongDan"]?.ToString()))
                            {
                                <a href="@evt["duongDan"]" class="d-block w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                    <img src="@hinhAnh" class="w-100" style="object-fit: contain; max-height: 400px;" alt="@evt["tenSuKien"]">
                                </a>
                            }
                            else
                            {
                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                    <img src="@hinhAnh" class="w-100" style="object-fit: contain; max-height: 400px;" alt="@evt["tenSuKien"]">
                                </div>
                            }
                        </div>
                    }
                </div>
                <button class="carousel-control-prev custom-carousel-btn" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
                    <i class="bi bi-chevron-left text-primary"></i>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next custom-carousel-btn" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
                    <i class="bi bi-chevron-right text-primary"></i>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        }
        else
        {
            <div class="p-4 h-100 rounded-3 position-relative overflow-hidden shadow-sm d-flex flex-column justify-content-center" style="background: linear-gradient(135deg, var(--primary-color) 0%, #17a2b8 100%);">
                <div class="position-relative z-1 text-white">
                    <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill fw-bold shadow-sm">CHUYÊN NGHIỆP & UY TÍN</span>
                    <h2 class="fw-bold mb-3">Trang thiết bị y tế chính hãng</h2>
                    <p class="fs-6 opacity-100 mb-4">Chẩn đoán - Hỗ trợ - Phục hồi. Giao hàng toàn quốc an toàn.</p>
                    <a href="#products" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-primary shadow">Khám phá ngay</a>
                </div>
                <i class="bi bi-heart-pulse position-absolute" style="font-size: 20rem; right: -30px; bottom: -80px; transform: rotate(-15deg); color: rgba(255,255,255,0.15);"></i>
            </div>
        }
    </div>

    <!-- Right: Small Banners -->
    <div class="col-lg-3 col-md-4 d-flex flex-column gap-3">
        @if (events != null && events.Count > 0)
        {
            var firstEvent = events.FirstOrDefault();
            var secondEvent = events.Skip(1).FirstOrDefault() ?? events.FirstOrDefault();
            
            string h1 = firstEvent["hinhAnh"]?.ToString() ?? "";
            if (h1.StartsWith("/images/")) h1 = "https://localhost:7001" + h1;
            
            string h2 = secondEvent["hinhAnh"]?.ToString() ?? "";
            if (h2.StartsWith("/images/")) h2 = "https://localhost:7001" + h2;

            <div class="card border-0 rounded-3 overflow-hidden shadow-sm flex-fill" style="max-height: 190px;">
                <img src="@h1" class="w-100 h-100" style="object-fit: cover;" alt="Banner 1" />
            </div>
            <div class="card border-0 rounded-3 overflow-hidden shadow-sm flex-fill" style="max-height: 190px;">
                <img src="@h2" class="w-100 h-100" style="object-fit: cover;" alt="Banner 2" />
            </div>
        }
        else
        {
            <div class="card border-0 rounded-3 shadow-sm flex-fill bg-light d-flex align-items-center justify-content-center" style="max-height: 190px;">
                <h5 class="text-muted">Quảng cáo 1</h5>
            </div>
            <div class="card border-0 rounded-3 shadow-sm flex-fill bg-light d-flex align-items-center justify-content-center" style="max-height: 190px;">
                <h5 class="text-muted">Quảng cáo 2</h5>
            </div>
        }
    </div>
</div>

<!-- Danh mục nổi bật -->
<div class="mb-5 p-4 p-md-5 rounded-4 shadow-sm" style="background-color: #f0f4f8;">
    <h4 class="fw-bold mb-4 text-dark d-flex align-items-center">
        <i class="bi bi-award text-primary me-2"></i> Danh mục nổi bật
    </h4>
    <div class="row g-3">
        @{
            string[] icons = { "bi-heart-pulse", "bi-capsule", "bi-bandaid", "bi-lungs", "bi-eye", "bi-thermometer", "bi-activity", "bi-droplet" };
            int iconIndex = 0;
        }
        @foreach (var c in (List<JObject>)ViewBag.DanhMuc)
        {
            var iconClass = icons[iconIndex % icons.Length];
            iconIndex++;
            <div class="col-lg-3 col-md-4 col-6">
                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c["categoryId"]" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 h-100 text-center py-4 bg-white hover-lift" style="transition: all 0.3s;">
                        <div class="mb-2 text-primary">
                            <i class="bi @iconClass" style="font-size: 2.5rem;"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@c["tenDanhMuc"]</h6>
                        <small class="text-muted">@(c["productCount"] ?? 0) sản phẩm</small>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
@if (ViewBag.GoiY != null && ((List<JObject>)ViewBag.GoiY).Count > 0)
{
    <div class="p-4 rounded-4 mb-5" style="background-color: #f0f7ff; border: 1px solid #cce3ff;">
        <div class="d-flex align-items-center mb-4">
            <div class="bg-warning text-dark rounded-circle p-2 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                <i class="bi bi-stars fs-4"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-dark">Gợi ý dành cho bạn</h4>
                <p class="text-muted small mb-0">Dựa trên lịch sử tìm kiếm và sở thích của bạn</p>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var p in (List<JObject>)ViewBag.GoiY)
            {
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="card card-product h-100 rounded-4">
                        <div class="position-relative">
                            <img src="@(p["hinhAnh"] ?? "/images/no-image.png")" class="card-img-top" style="object-fit: cover; height: 200px; padding: 1rem;" />
                            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 rounded-pill">Đề xuất</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="fw-bold text-dark mb-2 text-truncate">@p["tenSP"]</h6>
                            <div class="mb-3 text-warning small">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                                <span class="text-muted ms-1">(12)</span>
                            </div>
                            <div class="mt-auto">
                                <div class="fw-bold fs-5 text-primary mb-3">@(Convert.ToDecimal(p["gia"]).ToString("N0")) đ</div>
                                <a class="btn btn-outline-primary btn-rounded w-100 fw-medium" asp-controller="Products" asp-action="Detail" asp-route-id="@p["productId"]">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
<div class="mb-5 p-4 p-md-5 rounded-4 shadow-sm" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
    <h4 class="fw-bold mb-4 text-dark d-flex align-items-center" id="products">
        <i class="bi bi-star-fill text-warning me-2"></i> Sản phẩm nổi bật
    </h4>
    <div class="row g-4">
        @if (Model != null)
        {
            foreach (var p in Model["items"]!)
            {
                <div class="col-lg-3 col-md-4 col-6">
                    <div class="card card-product h-100 rounded-4 border-0 shadow-sm hover-lift">
                        <div class="position-relative overflow-hidden rounded-top-4 bg-white text-center">
                            <img src="@(p["hinhAnh"] ?? "/images/no-image.png")" class="card-img-top p-4" style="object-fit: contain; height: 220px; transition: transform 0.5s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" />
                        </div>
                        <div class="card-body d-flex flex-column bg-light p-3">
                            <div class="text-muted small mb-1 fw-medium text-truncate" title="@p["tenDanhMuc"]">@p["tenDanhMuc"]</div>
                            <h6 class="fw-bold text-dark mb-3" title="@p["tenSP"]" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 40px;">@p["tenSP"]</h6>
                            <div class="mt-auto">
                                <div class="fw-bold fs-5 text-danger mb-3">@(Convert.ToDecimal(p["gia"]).ToString("N0")) đ</div>
                                <a class="btn btn-outline-primary btn-rounded w-100 fw-medium shadow-sm hover-primary-bg" asp-controller="Products" asp-action="Detail" asp-route-id="@p["productId"]">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (ViewBag.ProductsByCategory != null)
{
    foreach (var group in (List<dynamic>)ViewBag.ProductsByCategory)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 mt-5">
            <h4 class="fw-bold mb-0 text-dark">@group.Name</h4>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@group.Id" class="btn btn-sm btn-primary rounded-pill px-4 fw-medium">Xem thêm</a>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 mb-4">
            @foreach (var p in (List<JObject>)group.Items)
            {
                <div class="col">
                    <div class="card card-product h-100 rounded-4 border-0 shadow-sm" style="transition: transform 0.3s, box-shadow 0.3s;">
                        <div class="position-relative overflow-hidden rounded-top-4 bg-white text-center">
                            <img src="@(p["hinhAnh"] ?? "/images/no-image.png")" class="card-img-top p-4" style="object-fit: contain; height: 180px; transition: transform 0.5s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" />
                        </div>
                        <div class="card-body d-flex flex-column bg-light p-3">
                            <div class="text-muted small mb-1 fw-medium text-truncate" title="@p["tenDanhMuc"]">@p["tenDanhMuc"]</div>
                            <h6 class="fw-bold text-dark mb-2" title="@p["tenSP"]" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px; font-size: 0.9rem;">@p["tenSP"]</h6>
                            <div class="mt-auto">
                                <div class="fw-bold fs-6 text-primary mb-2">@(Convert.ToDecimal(p["gia"]).ToString("N0")) đ</div>
                                <a class="text-decoration-none fw-bold small text-primary hover-primary" asp-controller="Products" asp-action="Detail" asp-route-id="@p["productId"]">Liên hệ <i class="bi bi-arrow-right ms-1"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- Section Tất cả sản phẩm -->
<div class="p-5 rounded-4 mb-5 text-center shadow-sm" style="background: linear-gradient(180deg, #ffffff 0%, #f0f7ff 100%); border: 1px solid #e6f0fa;">
    <div class="mb-3">
        <i class="bi bi-grid-3x3-gap-fill text-primary" style="font-size: 3rem;"></i>
    </div>
    <h3 class="fw-bold text-dark mb-3">Khám phá toàn bộ thiết bị y tế</h3>
    <p class="text-muted mb-4 mx-auto" style="max-width: 600px;">Hàng trăm sản phẩm chính hãng từ các thương hiệu uy tín hàng đầu đang chờ bạn. Hãy xem tất cả danh mục của chúng tôi.</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow hover-lift">
        Xem tất cả sản phẩm <i class="bi bi-arrow-right-circle ms-2"></i>
    </a>
</div>